<html lang="ar" dir="rtl">

  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>كشف مندوب</title>
  </head>

  <body class="px-20">
    <header class="rh rh--blue">
      <div class="rh-top">
        <div class="rh-brand">
          <img src="{{reportData.company.logo}}" />
          <div class="rh-company">{{reportData.company.name}}</div>
        </div>
        <div class="rh-title">كشف مندوب</div>
        <div class="rh-number">
          <div class="rh-label">رقم الكشف</div>
          <div class="rh-number-value">{{reportData.id}}</div>
          <div class="rh-label">{{date reportData.createdAt}}</div>
        </div>
      </div>
      <div class="rh-info">
        <div class="rh-info-item">
          <span class="rh-label">المندوب</span>
          <span class="rh-value">{{reportData.deliveryAgentReport.deliveryAgent.name}}</span>
        </div>
        <div class="rh-info-item">
          <span class="rh-label">ساحب الكشف</span>
          <span class="rh-value">{{reportData.createdBy.name}}</span>
        </div>
      </div>
      <div class="rh-stats">
        <div class="rh-stat">
          <div class="rh-label">طلبيات بغداد</div>
          <div class="rh-stat-count">{{reportData.baghdadOrdersCount}}</div>
        </div>
        <div class="rh-stat">
          <div class="rh-label">طلبيات المحافظات</div>
          <div class="rh-stat-count">{{reportData.governoratesOrdersCount}}</div>
        </div>
        <div class="rh-stat">
          <div class="rh-label">إجمالي الطلبيات</div>
          <div class="rh-stat-count">{{add
              reportData.baghdadOrdersCount
              reportData.governoratesOrdersCount
            }}</div>
        </div>
        <div class="rh-stat rh-due">
          <div class="rh-label">صافي الشركة</div>
          <div class="rh-due-value">{{currency reportData.companyNet}}</div>
          <div class="rh-due-row">
            <span>المبلغ المستلم</span>
            <span>{{currency reportData.paidAmount}}</span>
          </div>
          <div class="rh-due-row">
            <span>صافي المندوب</span>
            <span>{{currency reportData.deliveryAgentNet}}</span>
          </div>
        </div>
      </div>
    </header>
    <main>
      <table>
        <thead>
          <tr class="bg-blue">
            <th>#</th>
            <th>رقم الوصل</th>
            <th>أنشئ في</th>
            <th>الصفحة</th>
            <th>هاتف المستلم</th>
            <th>عنوان المستلم</th>
            <th>مبلغ الوصل</th>
            <th>المبلغ المستلم</th>
            <th>صافي المندوب</th>
            <th>الحالة</th>
          </tr>
        </thead>
        <tbody>
          {{#each orders}}
            <tr>
              <td class="nowrap">{{inc @index}}</td>
              <td>{{receiptNumber}}</td>
              <td>{{date createdAt}}</td>
              {{#if store}}
                <td>{{store.name}}</td>
              {{else}}
                <td></td>
              {{/if}}
              <td>{{mapPhones recipientPhones}}</td>
              <td>{{localizeGovernorate governorate}}
                -
                {{location.name}}
                -
                {{recipientAddress}}</td>
              <td>{{currency totalCost}}</td>
              <td>{{currency paidAmount}}</td>
              <td>{{currency deliveryAgentNet}}</td>
              <td class="{{colorizeRow status}}">{{localizeOrderStatus
                  status
                }}</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
      <div style="page-break-inside: avoid; break-inside: avoid;">
        <table>
          <tr>
            <td colspan="7" style="font-weight: bold;width:30%">المجموع</td>
            <td>اجمالي صافي الشركة: {{currency reportData.companyNet}}</td>
            <td>اجمالي مبلغ الوصل: {{currency reportData.totalCost}}</td>
            <td>اجمالي المبلغ المستلم: {{currency reportData.paidAmount}}</td>
            <td>اجمالي صافي المندوب:
              {{currency reportData.deliveryAgentNet}}</td>
          </tr>
        </table>
      </div>
    </main>
    <section class="watermark">{{reportData.company.name}}</section>
  </body>

</html>