<html lang="ar" dir="rtl">

  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>كشف فرع</title>
  </head>

  <body class="px-20">
    <header class="rh rh--blue">
      <div class="rh-top">
        <div class="rh-brand">
          <img src="{{reportData.company.logo}}" />
          <div class="rh-company">{{reportData.company.name}}</div>
        </div>
        <div class="rh-title">كشف فرع</div>
        <div class="rh-number">
          <div class="rh-label">رقم الكشف</div>
          <div class="rh-number-value">{{reportData.id}}</div>
          <div class="rh-label">{{date reportData.createdAt}}</div>
        </div>
      </div>
      <div class="rh-info">
        <div class="rh-info-item">
          <span class="rh-label">الفرع</span>
          <span class="rh-value">{{reportData.branchReport.branch.name}}</span>
        </div>
        <div class="rh-info-item">
          <span class="rh-label">ساحب الكشف</span>
          <span class="rh-value">{{reportData.createdBy.name}}</span>
        </div>
      </div>
      <div class="rh-stats">
        <div class="rh-stat">
          <div class="rh-label">طلبيات بغداد</div>
          <div class="rh-stat-count">{{reportData.baghdadOrdersCount}}</div>
        </div>
        <div class="rh-stat">
          <div class="rh-label">طلبيات المحافظات</div>
          <div class="rh-stat-count">{{reportData.governoratesOrdersCount}}</div>
        </div>
        <div class="rh-stat">
          <div class="rh-label">إجمالي الطلبيات</div>
          <div class="rh-stat-count">{{add
              reportData.baghdadOrdersCount
              reportData.governoratesOrdersCount
            }}</div>
        </div>
        <div class="rh-stat rh-due">
          <div class="rh-label">إجمالي المبلغ المستحق</div>
          <div class="rh-due-value">{{currency reportData.branchNet}}</div>
          <div class="rh-due-row">
            <span>مبلغ الوصل</span>
            <span>{{currency reportData.totalCost}}</span>
          </div>
          <div class="rh-due-row">
            <span>المبلغ المدفوع</span>
            <span>{{currency reportData.paidAmount}}</span>
          </div>
        </div>
      </div>
    </header>
    <main>
      <table>
        <thead>
          <tr class="bg-green">
            <th>#</th>
            <th>رقم الوصل</th>
            <th>أنشئ في</th>
            <th>الصفحة</th>
            <th>المندوب</th>
            <th>هاتف المستلم</th>
            <th>عنوان المستلم</th>
            <th>مبلغ الوصل</th>
            <th>المبلغ المستلم</th>
            <th>المبلغ المستقطع</th>
            <th>صافي الفرع</th>
            <th>الحالة</th>
          </tr>
        </thead>
        <tbody>
          {{#each orders}}
            <tr class="{{changed status totalCost paidAmount}}">
              <td class="nowrap">{{inc @index}}</td>
              <td>{{receiptNumber}}</td>
              <td>{{date createdAt}}</td>
              {{#if store}}
                <td>{{store.name}}</td>
              {{else}}
                <td></td>
              {{/if}}
              {{#if deliveryAgent}}
                <td>{{deliveryAgent.name}}</td>
              {{else}}
                <td></td>
              {{/if}}
              <td>{{mapPhones recipientPhones}}</td>
              <td>{{localizeGovernorate governorate}}
                -
                {{location.name}}</td>
              <td>{{currency totalCost}}</td>
              <td>{{currency paidAmount}}</td>
              <td>{{isBaghdad paidAmount branchNet}}</td>
              <td>{{currency branchNet}}</td>
              <td class="{{colorizeRow status}}">{{localizeOrderStatus
                  status
                }}</td>
            </tr>
          {{/each}}
        </tbody>

      </table>
      <!-- Force page break before totals, if needed -->
      <div style="page-break-inside: avoid; break-inside: avoid;">
        <table>
          <tr>
            <td colspan="7" style="font-weight: bold;width:30%">المجموع</td>
            <td style="font-weight: bold">مبلغ الوصل :
              {{currency reportData.totalCost}}</td>
            <td style="font-weight: bold">المبلغ المدفوع :
              {{currency reportData.paidAmount}}</td>
            <td style="font-weight: bold">إجمالي المبلغ المستحق :
              {{currency reportData.branchNet}}</td>
          </tr>
        </table>
      </div>
    </main>

    {{!-- <section class="watermark">{{reportData.company.name}}</section> --}}
  </body>

</html>