<html lang="ar">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>فاتورة</title>
    <style>
      .logo { width: 80px; } .footer{ display: flex;justify-content:
      space-between; align-items: end; margin-top: 20px; } .info{margin-top:
      10px;} .item{ display: flex; } .item span{ display: block; width:
      50%;font-size: 14px; border: 1px solid #333; padding: 5px;} .item
      span:first-child{ border-left:none } .removeTop{ border-top: none
      !important; } .address .item{ flex-direction: column;margin-top: 10px; }
      .address span{ width: unset !important; text-align: center; } .address
      .item span:first-child{ border-bottom:none;border-left: 1px solid #333
      }.details{margin-top: 15px;} .details .head{ text-align: center; padding:
      5px;background-color: rgba(255, 255, 0, 0.26); border: 1px solid #333 }
      .details .item span:first-child{ background-color: rgba(255, 255, 0,
      0.26); } @media print { * { -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important; color-adjust: exact !important; }
      span, div { border-color: #000 !important; /* Darker border for visibility
      */ } .item span { border: 1px solid #000 !important; /* Force black
      borders */ } /* Remove any unwanted scaling or shadows */ body {
      -webkit-filter: none !important; filter: none !important; } }
    </style>
  </head>
  <body style="direction: rtl">
    {{#each receipts}}
      <div
        style="position: relative;width:100%;display: flex;
            justify-content: space-between;
            align-items: center;"
      >
        <img src="{{QRCode this}}" />
        <img src="{{branch.companyLogo}}" class="logo" />
      </div>
      <div class="info">
        <div class="item">
          <span>شركة العميل</span>
          <span>{{branch.companyName}}</span>
        </div>
        <div class="item">
          {{#if (check store)}}
            <span class="removeTop">اسم الصفحه : {{store.name}}</span>
          {{else}}
            <span class="removeTop">اسم الصفحه :</span>
          {{/if}}
          <span class="removeTop">رقم الوصل : {{receiptNumber}}</span>
        </div>
        <div class="item">
          {{#if (check store)}}
            <span class="removeTop">رقم العميل :
              {{showNumber client.showNumbers client.phone}}</span>
          {{else}}
            <span class="removeTop">رقم العميل :</span>
          {{/if}}
          <span class="removeTop">التاريخ : </span>
        </div>
      </div>
      <div class="info">
        <div class="item">
          <span style="background-color:rgba(255, 255, 0, 0.26) ;">اسم الزبون</span>
          <span></span>
        </div>
      </div>
      <div class="address">
        <div class="item">
          <span
            style="background-color:rgba(255, 255, 0, 0.26) ;"
          >العنوان</span>
          <span style="padding: 20px;"></span>
        </div>
      </div>
      <div class="details">
        <div class="head">
          <span>تفاصيل الطلب</span>
        </div>
        <div class="item">
          <span class="removeTop" style="width: 30%;">الكمية</span>
          <span class="removeTop" style="width: 70%;"></span>
        </div>
        <div class="item">
          <span class="removeTop" style="width: 30%;">تفاصيل الطلب</span>
          <span class="removeTop" style="width: 70%;"></span>
        </div>
        <div class="item">
          <span class="removeTop" style="width: 30%;">ملاحظات</span>
          <span class="removeTop" style="width: 70%;">{{notes}}</span>
        </div>
        <div class="item">
          <span class="removeTop">المبلغ مع التوصيل</span>
          <span class="removeTop"></span>
        </div>
      </div>
      <div class="footer">
        <div>
          <span style="display: block;">ملاحظات مهمة : </span>
          <span style="display: block;">* الشركة مسؤوله عن توصيل الطلبات فقط</span>
        </div>
        <div style="margin-top: 10px;">
          <img src="{{QRCode this}}" />
          <span
            style="display: block;text-align:center;font-weight:bold"
          >{{receiptNumber}}</span>
        </div>
      </div>
      {{#unless @last}}
        <div style="page-break-before: always;"></div>
      {{/unless}}
      <!-- Forces a new page -->
    {{/each}}
  </body>
</html>