<html lang="ar" dir="rtl">

  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تقرير كشوفات عميل</title>
  </head>

  <body class="px-20">
    <header>
      <table>
        <tr>
          <td style="width: 25%;"></td>
          <td style="width: 25%;" class="title">تقرير كشوفات الشركات</td>
          <td style="width: 25%;">عدد الطلبيات:
            <span>{{add
                reportsData.baghdadOrdersCount
                reportsData.governoratesOrdersCount
              }}</span></td>
          <td style="width: 25%;" rowspan="3"><img
              src="{{reportsData.company.logo}}"
            /></td>
        </tr>
        <tr>
          <td style="width: 25%;"></td>
          <td style="width: 25%;">عدد الكشوفات:
            <span>{{reportsData.count}}</span></td>
          <td style="width: 25%;">عدد طلبيات بغداد:
            <span>{{reportsData.baghdadOrdersCount}}</span></td>
          <td style="width: 25%;"></td>
        </tr>
        <tr>
          <td style="width: 25%;">صافي الشركة:
            <span>{{currency reportsData.companyNet}}</span></td>
          <td style="width: 25%;">التاريخ:
            <span>{{date reportsData.date}}</span></td>
          <td style="width: 25%;">عدد طلبيات المحافظات:
            <span>{{reportsData.governoratesOrdersCount}}</span></td>
          <td style="width: 25%;"></td>
        </tr>
      </table>
    </header>
    <main>
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>رقم الكشف</th>
            <th>الشركة</th>
            <th>المحاسب</th>
            <th>صافي الشركة</th>
            <th>طلبيات بغداد</th>
            <th>طلبيات المحافظات</th>
            <th>اجور بغداد</th>
            <th>اجور المحافظات</th>
            <th>التاريخ</th>
          </tr>
        </thead>
        <tbody>
          {{#each reports}}
            <tr>
              <td class="nowrap">{{inc @index}}</td>
              <td>{{id}}</td>
              <td>{{companyReport.company.name}}</td>
              <td>{{createdBy.name}}</td>
              <td>{{currency companyNet}}</td>
              <td>{{baghdadOrdersCount}}</td>
              <td>{{governoratesOrdersCount}}</td>
              <td>{{currency companyReport.baghdadDeliveryCost}}</td>
              <td>{{currency companyReport.governoratesDeliveryCost}}</td>
              <td>{{date createdAt}}</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </main>
  </body>

</html>