<html lang="ar" dir="rtl">

  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {{#if (eq reportData.clientReport.secondaryType)}}
      <title>كشف الواصل للعميل</title>
    {{else}}
      <title>كشف الراجع للعميل</title>
    {{/if}}
  </head>

  <body class="px-20">
    <header class="rh rh--{{colorizeTitle reportData.clientReport.secondaryType}}">
      <div class="rh-top">
        <div class="rh-brand">
          <img src="{{reportData.company.logo}}" />
          <div class="rh-company">{{reportData.company.name}}</div>
        </div>
        <div class="rh-title">
          {{#if (eq reportData.clientReport.secondaryType)}}
            كشف الواصل للعميل
          {{else}}
            كشف الراجع للعميل
          {{/if}}
          {{#if reportData.draft}}<span class="rh-tag">مسودة للمراجعة</span>{{/if}}
        </div>
        <div class="rh-number">
          {{#if reportData.draft}}
            <div class="rh-label">رقم طلب الحساب</div>
            <div class="rh-number-value">{{reportData.draft.requestId}}</div>
          {{else}}
            <div class="rh-label">رقم الكشف</div>
            <div class="rh-number-value">{{reportData.id}}</div>
          {{/if}}
          <div class="rh-label">{{date reportData.createdAt}}</div>
        </div>
      </div>

      <div class="rh-info">
        <div class="rh-info-item">
          <span class="rh-label">العميل</span>
          <span class="rh-value">{{reportData.clientReport.client.name}}</span>
        </div>
        <div class="rh-info-item">
          <span class="rh-label">الصفحة</span>
          <span class="rh-value">{{reportData.clientReport.store.name}}</span>
        </div>
        <div class="rh-info-item">
          {{#if reportData.draft}}
            <span class="rh-label">طريقة الاستلام</span>
            <span class="rh-value">{{reportData.draft.receiveMethod}}</span>
          {{else}}
            <span class="rh-label">ساحب الكشف</span>
            <span class="rh-value">{{reportData.createdBy.name}}</span>
          {{/if}}
        </div>
      </div>

      <div class="rh-stats">
        <div class="rh-stat">
          <div class="rh-label">طلبيات بغداد</div>
          <div class="rh-stat-count">{{reportData.baghdadOrdersCount}}</div>
          <div class="rh-stat-total">{{currency reportData.baghdadTotal}}</div>
        </div>
        <div class="rh-stat">
          <div class="rh-label">طلبيات المحافظات</div>
          <div class="rh-stat-count">{{reportData.governoratesOrdersCount}}</div>
          <div class="rh-stat-total">{{currency reportData.otherTotal}}</div>
        </div>
        <div class="rh-stat">
          <div class="rh-label">البريد الداخلي</div>
          <div class="rh-stat-count">{{reportData.insideOrdersCount}}</div>
          <div class="rh-stat-total">{{currency reportData.insideTotal}}</div>
        </div>
        <div class="rh-stat">
          <div class="rh-label">إجمالي الطلبيات</div>
          <div class="rh-stat-count">{{add
              reportData.baghdadOrdersCount
              reportData.governoratesOrdersCount
            }}</div>
          <div class="rh-stat-total">{{currency reportData.total}}</div>
        </div>
        {{#if (eq reportData.clientReport.secondaryType)}}
          <div class="rh-stat rh-due">
            <div class="rh-label">إجمالي المبلغ المستحق</div>
            <div class="rh-due-value">{{currency reportData.clientNet}}</div>
            {{#if reportData.loansDeduction}}
              <div class="rh-due-row">
                <span>خصم السلف</span>
                <span>- {{currency reportData.loansDeduction}}</span>
              </div>
              <div class="rh-due-row rh-due-final">
                <span>الصافي بعد الخصم</span>
                <span>{{currency reportData.clientDue}}</span>
              </div>
            {{/if}}
          </div>
        {{/if}}
      </div>
    </header>
    {{#if reportData.draft}}
      <div class="rh-draft">{{reportData.draft.message}}</div>
    {{/if}}
    <main>
      <table>
        <thead>
          <tr class="{{colorizeHeader reportData.clientReport.secondaryType}}">
            <th>#</th>
            <th>رقم الوصل</th>
            <th>أنشئ في</th>
            <th>اسم المستلم</th>
            <th>هاتف المستلم</th>
            <th>عنوان المستلم</th>
            <th>مبلغ الوصل</th>
            <th>المبلغ المستلم</th>
            {{#if (eq reportData.clientReport.secondaryType)}}
              <th>مبلغ التوصيل</th>
              <th>صافي العميل</th>
            {{/if}}
            <th>الحالة</th>
            <th>الملاحظات</th>
          </tr>
        </thead>
        <tbody>
          {{#each orders}}
            <tr class="{{changed status totalCost paidAmount}}">
              <td class="nowrap">{{inc @index}}</td>
              <td>{{receiptNumber}}</td>
              <td>{{date createdAt}}</td>
              <td>{{recipientName}}</td>
              <td>{{mapPhones recipientPhones}}</td>
              <td>{{localizeGovernorate governorate}} - {{location.name}}</td>
              <td>{{currency totalCost}}</td>
              <td>{{currency paidAmount}}</td>
              {{#if (eq @root.reportData.clientReport.secondaryType)}}
                <td>{{currency deliveryCost}}</td>
                <td>{{currency clientNet}}</td>
              {{/if}}
              {{!-- <td class="{{colorizeRow2 ../reportData.clientReport.secondaryType status}}">{{localizeOrderStatus status}}</td> --}}
              <td class="{{colorizeRow2 status}}">{{localizeOrderStatus
                  status
                }}</td>
              <td>{{clientNotes}}</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
      <!-- Force page break before totals, if needed -->
      <div style="page-break-inside: avoid; break-inside: avoid;">
        <table>
          <tr>
            {{#if (eq reportData.clientReport.secondaryType)}}
              <td colspan="7" style="font-weight: bold;width:50%">إجمالي المبلغ
                المستحق
              </td>
              <td style="font-weight: bold">{{currency
                  reportData.clientNet
                }}</td>
            {{/if}}
          </tr>
          {{#if reportData.loansDeduction}}
            <tr>
              <td colspan="7" style="font-weight: bold;width:50%">خصم السلف</td>
              <td style="font-weight: bold">{{currency
                  reportData.loansDeduction
                }}</td>
            </tr>
            <tr>
              <td colspan="7" style="font-weight: bold;width:50%">صافي المبلغ
                المستحق بعد خصم السلف
              </td>
              <td style="font-weight: bold">{{currency
                  reportData.clientDue
                }}</td>
            </tr>
          {{/if}}
        </table>
      </div>
    </main>

    {{!-- <section class="watermark">{{reportData.company.name}}</section> --}}
  </body>

</html>