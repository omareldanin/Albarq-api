    <style>
      @font-face {
        font-family: "Receipt Arabic";
        font-style: normal;
        font-weight: 400;
        font-display: block;
        src: url(data:font/ttf;base64,)
          format("truetype");
      }
      @font-face {
        font-family: "Receipt Arabic";
        font-style: normal;
        font-weight: 700;
        font-display: block;
        src: url(data:font/ttf;base64,)
          format("truetype");
      }
      /* A5 portrait. The production .hbs embeds this CSS and the Arabic fonts. */
      @page {
        size: 148mm 210mm;
        margin: 0;
      }
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        padding: 0;
      }
      body {
        color: #111;
        background: #fff;
        font-family: "Receipt Arabic", Tahoma, Arial, sans-serif;
        font-size: 11pt;
        line-height: 1.65;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      .receipt {
        direction: rtl;
        width: 148mm;
        height: 209.5mm;
        padding: 8mm;
        display: flex;
        flex-direction: column;
        gap: 3.5mm;
        background: #fff;
        break-inside: avoid;
        page-break-inside: avoid;
      }
      .receipt + .receipt {
        break-before: page;
        page-break-before: always;
      }
      .receipt > * {
        flex-shrink: 0;
      }
      .receipt-header {
        display: flex;
        direction: ltr;
        justify-content: space-between;
        align-items: center;
        gap: 8mm;
        min-height: 28mm;
      }
      .brand {
        flex: 1;
        min-width: 0;
        text-align: left;
      }
      .logo {
        display: block;
        width: 58mm;
        height: 20mm;
        margin-right: auto;
        margin-left: 0;
        object-fit: contain;
        object-position: left center;
      }
      .brand-fallback {
        font-size: 24pt;
        font-weight: 700;
        line-height: 1.4;
      }
      .brand-caption {
        margin-top: 1mm;
        font-size: 9pt;
      }
      .qr-wrap {
        flex: 0 0 29mm;
        width: 29mm;
        text-align: center;
      }
      .qr {
        display: block;
        width: 29mm;
        height: 29mm;
        padding: 2mm;
        object-fit: contain;
        background: #fff;
      }
      .qr-caption {
        font-size: 7pt;
        line-height: 1.5;
      }
      .receipt-reference {
        border-top: 0.7mm solid #111;
        border-bottom: 0.25mm solid #111;
        padding: 3mm 0;
      }
      .reference-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 5mm;
      }
      .reference-label {
        font-weight: 700;
        font-size: 12pt;
        white-space: nowrap;
      }
      .receipt-number {
        min-width: 0;
        font-family: Arial, sans-serif;
        font-size: 29pt;
        font-weight: 700;
        line-height: 1.15;
        letter-spacing: 0.6px;
        overflow-wrap: anywhere;
      }
      .date-row {
        display: flex;
        justify-content: space-between;
        gap: 5mm;
        margin-top: 2mm;
        font-size: 8.5pt;
      }
      .date-value,
      .phone {
        font-variant-numeric: tabular-nums;
      }
      .label {
        display: block;
        font-size: 8.5pt;
        line-height: 1.7;
        font-weight: 400;
      }
      .value {
        display: block;
        font-size: 12pt;
        line-height: 1.65;
        font-weight: 700;
        overflow-wrap: anywhere;
        min-width: 0;
      }
      .customer-card {
        border: 0.3mm solid #111;
      }
      .customer-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
      }
      .customer-row + .customer-row {
        border-top: 0.25mm solid #111;
      }
      .customer-cell {
        min-width: 0;
        padding: 2mm 3mm;
      }
      .customer-cell + .customer-cell {
        border-right: 0.25mm solid #111;
      }
      .company-value {
        font-size: 10pt;
        font-weight: 400;
      }
      .phone {
        font-family: Arial, sans-serif;
        font-size: 12pt;
        font-weight: 700;
        line-height: 1.8;
      }
      .recipient-phone {
        padding: 1.5mm 3mm;
        border-top: 0.25mm solid #111;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 3mm;
      }
      .address-card {
        border: 0.3mm solid #111;
        padding: 2.5mm 3mm;
      }
      .address-region {
        font-size: 14pt;
        font-weight: 700;
        line-height: 1.65;
        margin: 0.5mm 0;
        overflow-wrap: anywhere;
      }
      .address-text {
        font-size: 11pt;
        line-height: 1.7;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
      }
      .section-heading {
        font-size: 10pt;
        font-weight: 700;
        margin: 0 0 1.5mm;
      }
      .details-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        border: 0.3mm solid #111;
      }
      .details-table th,
      .details-table td {
        border: 0.25mm solid #111;
        padding: 2mm 3mm;
        text-align: right;
        vertical-align: top;
      }
      .details-table th {
        width: 28mm;
        font-size: 9pt;
        font-weight: 700;
      }
      .details-table td {
        font-size: 10.5pt;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
      }
      .quantity {
        font-family: Arial, sans-serif;
        font-size: 14pt;
        font-weight: 700;
        line-height: 1.5;
      }
      .notes-value {
        min-height: 7mm;
      }
      .amount-box {
        border: 0.6mm solid #111;
        padding: 3mm 4mm;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 4mm;
      }
      .amount-label {
        font-size: 11pt;
        font-weight: 700;
        line-height: 1.6;
        max-width: 37mm;
      }
      .amount-value {
        font-size: 26pt;
        line-height: 1.6;
        font-weight: 700;
        min-width: 0;
        overflow-wrap: anywhere;
        font-variant-numeric: tabular-nums;
      }
      .receipt-footer {
        margin-top: auto;
        padding-top: 2mm;
      }
      .footer-note {
        border-top: 0.25mm solid #111;
        padding-top: 2mm;
        font-size: 8.5pt;
        line-height: 1.7;
      }
      .tracking {
        margin-top: 4mm;
        text-align: center;
      }
      .barcode {
        display: block;
        width: 87mm;
        max-width: 100%;
        height: 15mm;
        object-fit: contain;
        margin: 0 auto 1mm;
      }
      .tracking-number {
        font-family: Arial, sans-serif;
        font-size: 11pt;
        font-weight: 700;
        line-height: 1.5;
        letter-spacing: 1.2px;
        overflow-wrap: anywhere;
      }
      .tracking-caption {
        font-size: 7pt;
        line-height: 1.7;
      }
      /* Compact physical spacing keeps the text readable on A5. */
      body {
        font-size: 10pt;
        line-height: 1.4;
      }
      .receipt {
        gap: 2.5mm;
      }
      .receipt-header {
        min-height: 24mm;
      }
      .logo {
        width: 54mm;
        height: 17mm;
      }
      .brand-caption {
        font-size: 8pt;
      }
      .qr-wrap {
        flex-basis: 24mm;
        width: 24mm;
      }
      .qr {
        width: 24mm;
        height: 24mm;
        padding: 1.5mm;
      }
      .qr-caption {
        font-size: 6.5pt;
        line-height: 1.3;
      }
      .receipt-reference {
        padding: 2mm 0;
      }
      .receipt-number {
        font-size: 25pt;
        line-height: 1.1;
      }
      .date-row {
        margin-top: 1mm;
        font-size: 8pt;
      }
      .label {
        font-size: 7.5pt;
        line-height: 1.4;
      }
      .value {
        font-size: 10.5pt;
        line-height: 1.5;
      }
      .customer-cell {
        padding: 1.5mm 3mm;
      }
      .company-value {
        font-size: 9pt;
      }
      .phone {
        font-size: 10.5pt;
        line-height: 1.5;
      }
      .recipient-phone {
        padding: 1mm 3mm;
      }
      .address-card {
        padding: 2mm 3mm;
      }
      .address-region {
        font-size: 12pt;
        line-height: 1.45;
        margin: 0.25mm 0;
      }
      .address-text {
        font-size: 10pt;
        line-height: 1.5;
      }
      .section-heading {
        font-size: 9pt;
        margin-bottom: 1mm;
      }
      .details-table th,
      .details-table td {
        padding: 1.2mm 3mm;
      }
      .details-table th {
        font-size: 8pt;
      }
      .details-table td {
        font-size: 9.5pt;
        line-height: 1.45;
      }
      .quantity {
        font-size: 12pt;
        line-height: 1.3;
      }
      .notes-value {
        min-height: 5mm;
      }
      .amount-box {
        padding: 2mm 4mm;
      }
      .amount-label {
        font-size: 10pt;
      }
      .amount-value {
        font-size: 23pt;
        line-height: 1.35;
      }
      .footer-note {
        font-size: 7.5pt;
        line-height: 1.4;
        padding-top: 1.5mm;
      }
      .tracking {
        margin-top: 2mm;
      }
      .barcode {
        height: 12mm;
      }
      .tracking-number {
        font-size: 9pt;
        line-height: 1.3;
      }
      .tracking-caption {
        font-size: 6.5pt;
        line-height: 1.3;
      }
      /* Applied by the optional PDF preflight only when a long order needs it. */
      .receipt--compact {
        gap: 1.6mm;
      }
      .receipt--compact .customer-cell {
        padding-top: 1mm;
        padding-bottom: 1mm;
      }
      .receipt--compact .address-card {
        padding-top: 1.5mm;
        padding-bottom: 1.5mm;
      }
      .receipt--compact .address-text {
        font-size: 9pt;
      }
      .receipt--compact .details-table td {
        font-size: 9pt;
      }
      .receipt--compact .details-table th,
      .receipt--compact .details-table td {
        padding-top: 0.8mm;
        padding-bottom: 0.8mm;
      }
      .receipt--compact .tracking {
        margin-top: 1mm;
      }
      .receipt--compact .barcode {
        height: 10mm;
      }
      @media screen {
        body {
          background: #e8e9eb;
        }
        .receipt {
          margin: 8mm auto;
          box-shadow: 0 2mm 8mm #00000014;
        }
      }
      @media print {
        .receipt {
          margin: 0;
          box-shadow: none;
        }
        .preview-toolbar {
          display: none !important;
        }
      }
    </style>
  </head>
  <body>
    {{#each orders}}
      <article class="receipt" aria-label="وصل توصيل {{receiptNumber}}">
        <header class="receipt-header">
          <div class="brand" dir="rtl">
            {{#if client.logo}}
              <img class="logo" src="{{client.logo}}" alt="شعار الشركة" />
            {{else}}
              <div class="brand-fallback">وصل توصيل</div>
            {{/if}}
            <div class="brand-caption">خدمة توصيل الطلبات</div>
          </div>
          <div class="qr-wrap">
            <img class="qr" src="{{QRCode this}}" alt="رمز تتبع الوصل" />
            <div class="qr-caption" dir="rtl">امسح رمز الوصل</div>
          </div>
        </header>

        <section class="receipt-reference">
          <div class="reference-row">
            <span class="reference-label">رقم الوصل</span>
            <bdi class="receipt-number" dir="ltr">{{receiptNumber}}</bdi>
          </div>
          <div class="date-row">
            <span>وصل توصيل</span>
            <span>التاريخ:
              <bdi class="date-value">{{date createdAt}}</bdi></span>
          </div>
        </section>

        <section class="customer-card" aria-label="بيانات العميل والزبون">
          <div class="customer-row">
            <div class="customer-cell">
              <span class="label">المتجر / اسم الصفحة</span>
              <span class="value">{{store.name}}</span>
            </div>
            <div class="customer-cell">
              <span class="label">اسم الزبون</span>
              <span class="value">{{recipientName}}</span>
            </div>
          </div>
          <div class="customer-row">
            <div class="customer-cell">
              <span class="label">شركة العميل / الفرع</span>
              <span class="value company-value">{{client.company}}
                -
                {{client.branch}}</span>
            </div>
            <div class="customer-cell">
              <span class="label">رقم العميل</span>
              <bdi class="phone" dir="ltr">{{showNumber
                  client.showNumbers
                  client.phone
                }}</bdi>
            </div>
          </div>
          {{#if recipientPhone}}
            <div class="recipient-phone">
              <span class="label">هاتف الزبون</span>
              <bdi class="phone" dir="ltr">{{recipientPhone}}</bdi>
            </div>
          {{/if}}
        </section>

        <section class="address-card" aria-label="عنوان التوصيل">
          <span class="label">عنوان التوصيل</span>
          <div class="address-region">{{localizeGovernorate governorate}}
            -
            {{location.name}}</div>
          <div class="address-text">{{recipientAddress}}</div>
        </section>

        <section aria-label="تفاصيل الطلب">
          <h2 class="section-heading">تفاصيل الطلب</h2>
          <table class="details-table">
            <tbody>
              <tr>
                <th scope="row">الكمية</th>
                <td><bdi class="quantity">{{quantity}}</bdi></td>
              </tr>
              <tr>
                <th scope="row">نوع البضاعة</th>
                <td>{{details}}</td>
              </tr>
              <tr>
                <th scope="row">الملاحظات</th>
                <td><div class="notes-value">{{clientNotes}}</div></td>
              </tr>
            </tbody>
          </table>
        </section>

        <section class="amount-box" aria-label="المبلغ مع التوصيل">
          <span class="amount-label">المبلغ مع التوصيل</span>
          <bdi class="amount-value">{{currency totalCost}}</bdi>
        </section>

        <footer class="receipt-footer">
          <div class="footer-note"><strong>ملاحظة مهمة:</strong>
            الشركة مسؤولة عن توصيل الطلبات فقط.</div>
          <div class="tracking">
            {{!-- {{#if QRCode}} --}}
            <img
              class="barcode"
              src="{{QRCode this}}"
              alt="باركود الوصل {{receiptNumber}}"
            />
            {{!-- {{/if}} --}}
            <div class="tracking-number" dir="ltr">{{receiptNumber}}</div>
            <div class="tracking-caption">يرجى الاحتفاظ برقم الوصل للمتابعة</div>
          </div>
        </footer>
      </article>
    {{/each}}

  </body>
</html>